function toggleMode(){document.body.classList.toggle('light')}

const canvas=document.getElementById('particles');
const ctx=canvas.getContext('2d');
canvas.width=window.innerWidth;canvas.height=window.innerHeight;
let particles=[];

class Particle{
  constructor(){this.x=Math.random()*canvas.width;this.y=Math.random()*canvas.height;this.size=2;this.speedX=Math.random()*1-0.5;this.speedY=Math.random()*1-0.5}
  update(){this.x+=this.speedX;this.y+=this.speedY}
  draw(){ctx.fillStyle='gold';ctx.beginPath();ctx.arc(this.x,this.y,this.size,0,Math.PI*2);ctx.fill()}
}

function init(){particles=[];for(let i=0;i<120;i++)particles.push(new Particle())}
function animate(){ctx.clearRect(0,0,canvas.width,canvas.height);particles.forEach(p=>{p.update();p.draw()});requestAnimationFrame(animate)}
init();animate();
window.addEventListener('resize',()=>{canvas.width=window.innerWidth;canvas.height=window.innerHeight;init()});
</script></body>
