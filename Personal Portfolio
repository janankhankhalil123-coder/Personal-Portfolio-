*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
body{background:var(--bg);color:var(--text);overflow-x:hidden;transition:.4s}

/* NAVBAR */
nav{
  position:fixed;top:0;left:0;width:100%;
  background:var(--nav);
  backdrop-filter:blur(10px);
  display:flex;justify-content:space-between;align-items:center;
  padding:12px 25px;
  z-index:100;
  animation:slideDown .8s ease;
}

nav h2{font-size:18px;color:gold}

nav ul{display:flex;gap:20px;list-style:none}

nav ul li a{
  text-decoration:none;
  color:var(--text);
  transition:.3s;
  font-size:14px;
}

nav ul li a:hover{color:orange}

.toggle{
  padding:6px 12px;border:1px solid gold;border-radius:20px;
  cursor:pointer;background:transparent;color:gold
}

header{
  min-height:100vh;display:flex;justify-content:center;align-items:center;
  gap:40px;flex-wrap:wrap;padding:80px 40px 40px;position:relative;z-index:1
}

.profile-pic{
  width:180px;height:180px;border-radius:50%;border:3px solid gold;
  object-fit:cover;box-shadow:0 0 25px gold;animation:zoomIn 1.5s ease
}

.intro h1{
  font-size:3rem;
  background:linear-gradient(90deg,gold,orange,red);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent
}

.typing{
  font-size:1.3rem;margin-top:10px;border-right:2px solid gold;
  white-space:nowrap;overflow:hidden;width:0;
  animation:typing 6s steps(40,end) infinite alternate,blink .7s infinite
}

section{padding:60px 20px;text-align:center;position:relative;z-index:1}

.card{background:var(--card);margin:20px auto;padding:20px;max-width:400px;border-radius:15px;box-shadow:0 0 15px rgba(212,175,55,.5);transition:.4s}
.card:hover{transform:translateY(-10px) scale(1.05);box-shadow:0 0 30px gold}

.skills{display:flex;flex-wrap:wrap;justify-content:center;gap:15px;margin-top:20px}

.skill{padding:10px 20px;border:1px solid gold;border-radius:20px;background:rgba(255,215,0,0.1);transition:.3s;cursor:pointer}
.skill:hover{background:gold;color:black}

.btns{display:flex;gap:15px;justify-content:center;margin-top:20px;flex-wrap:wrap}
.btn{padding:10px 20px;border:1px solid gold;border-radius:25px;text-decoration:none;color:var(--text)}

iframe{margin-top:20px;border:0;width:90%;height:250px;border-radius:10px}

footer{text-align:center;padding:20px;background:var(--card)}

/* animations */
@keyframes typing{from{width:0}to{width:100%}}
@keyframes blink{50%{border-color:transparent}}
@keyframes zoomIn{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes slideDown{from{transform:translateY(-100%);opacity:0}to{transform:translateY(0);opacity:1}}

#particles{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0}

